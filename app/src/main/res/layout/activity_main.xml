<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E7E7FF"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:background="@drawable/bg_header_gradient"
        android:fontFamily="@font/poppins_black"
        android:gravity="center"
        android:letterSpacing="0.05"
        android:padding="20dp"
        android:text="TOKO MUSIK ARYO"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardJual"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="1dp"
        app:layout_constraintTop_toBottomOf="@id/tvHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/imgJual"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_alatmusik"
                android:scaleType="centerCrop"
                android:contentDescription="Penjualan Alat Musik"/>

            <TextView
                android:id="@+id/tvJual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="JUAL ALAT MUSIK"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="#80000000"
                android:gravity="center"
                android:padding="10dp"
                android:layout_gravity="bottom"/>
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardSewa"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="1dp"
        app:layout_constraintTop_toBottomOf="@id/cardJual"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/imgSewa"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_sound"
                android:scaleType="centerCrop"
                android:contentDescription="Penyewaan Sound System"/>

            <TextView
                android:id="@+id/tvSewa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SEWA SOUND SYSTEM"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="#80000000"
                android:gravity="center"
                android:padding="10dp"
                android:layout_gravity="bottom"/>
        </FrameLayout>
    </androidx.cardview.widget.CardView>


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnProfil"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_button_blue"
        android:backgroundTint="@null"
        android:fontFamily="@font/poppins_bold"
        android:text="PROFIL"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/btnExit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardSewa"
        app:layout_constraintVertical_bias="0.876" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnExit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="100dp"
        android:background="@drawable/bg_button_red"
        android:backgroundTint="@null"
        android:fontFamily="@font/poppins_bold"
        android:text="KELUAR"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
